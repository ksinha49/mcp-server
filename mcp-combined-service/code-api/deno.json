{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-explicit-any"]
    }
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 100,
    "singleQuote": true
  },
  "tasks": {
    "start": "deno run --allow-net=localhost --allow-read=. --allow-env=PYTHON_BACKEND_URL,DENO_PORT server.ts",
    "dev": "deno run --watch --allow-net=localhost --allow-read=. --allow-env=PYTHON_BACKEND_URL,DENO_PORT server.ts",
    "test": "deno test --allow-read",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "imports": {
    "@std/": "https://deno.land/std@0.220.0/"
  }
}
