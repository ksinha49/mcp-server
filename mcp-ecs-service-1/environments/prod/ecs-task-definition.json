{
  "family": "mcp-server-task",
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "requiresCompatibilities": ["FARGATE"],
  "executionRoleArn": "arn:aws:iam::113284361828:role/alic-aio-mcp-ecs-task-execution-iam-role",
  "containerDefinitions": [
    {
      "name": "mpc-sample-service-container",
      "image": "113284361828.dkr.ecr.us-east-2.amazonaws.com/aicoe/mpc-sample-service:latest",
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "essential": true
    }
  ]
}
